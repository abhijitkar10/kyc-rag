# Copy this file to .env and paste your key in.  (.env is gitignored — it never
# gets committed, so your key stays private.)
#
#     cp .env.example .env      # then edit .env and paste your key below
#
# Get a FREE Gemini key (no credit card): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- optional overrides ---
# Use Claude instead of Gemini (needs a paid Anthropic key):
# ANTHROPIC_API_KEY=
#
# Pick a specific model (defaults shown):
# GEMINI_MODEL=gemini-2.5-flash
# CLAUDE_MODEL=claude-haiku-4-5
#
# Retriever for the answer pipeline: hybrid (default, fast) or rerank (peak quality):
# RETRIEVER=hybrid
